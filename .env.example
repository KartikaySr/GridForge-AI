# Legacy Phase 0 / optional database only. Copy to .env; never commit .env.
# Phase 1 native runtime ignores these values and bootstraps through a private pipe.
# Runtime is simulation-only; other modes are rejected.
GRIDFORGE_MODE=SIMULATION
GRIDFORGE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GRIDFORGE_TELEMETRY_URL=http://127.0.0.1:8000/api/v1/telemetry
# Vite reads this variable from the root environment directory.
VITE_API_URL=http://127.0.0.1:8000
# Required only for optional PostgreSQL development container; supply locally.
POSTGRES_USER=gridforge
POSTGRES_DB=gridforge
POSTGRES_PASSWORD=
# Phase 8 optional sync. Set these as process environment variables; .env is not loaded by the native runtime.
# The cloud receiver uses PostgreSQL and should be reached through HTTPS outside loopback.
GRIDFORGE_CLOUD_DATABASE_URL=
GRIDFORGE_CLOUD_URL=
GRIDFORGE_EDGE_TOKEN=
# Phase 9: local extractive baseline by default; disabled yields explicit AI unavailability.
GRIDFORGE_AI_PROVIDER=local
# Optional central backends, supplied only to the native process/runtime (never VITE_*).
# Reader login must be a member of gridforge_ai_reader; writer is CLI-only.
GRIDFORGE_AI_KNOWLEDGE_DSN=
GRIDFORGE_AI_QUERY_DSN=
GRIDFORGE_KNOWLEDGE_WRITER_DSN=
